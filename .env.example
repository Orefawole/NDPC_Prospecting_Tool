# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# Claude model and effort used for evidence analysis
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# sqlite for local use; for Postgres use postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///data/prospects.db

# Crawler politeness
CRAWL_USER_AGENT=ProspectIntelBot/0.1 (+contact: set-your-contact-url)
CRAWL_DELAY_SECONDS=2
CRAWL_MAX_PAGES_PER_SITE=6
